# Yumi environment — copy to .env and fill in
NODE_ENV=development

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Data
MONGO_URI=mongodb://localhost:27017/yumi
REDIS_URL=redis://localhost:6379

# Auth (generate strong random values in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=1209600     # seconds (14 days)

# AI assistant (Anthropic). Leave blank to disable the AI panel gracefully.
ANTHROPIC_API_KEY=

# OAuth (optional for Phase 0 local dev; leave blank to disable)
# --- SSO (OpenID Connect) ---
# Comma-separated provider ids, then per-provider settings. Works with any
# spec-compliant IdP (Google, Okta, Auth0, Entra). GitHub is NOT supported here:
# it speaks plain OAuth2 with no ID token.
#   OIDC_PROVIDERS=okta
#   OIDC_OKTA_ISSUER=https://your-org.okta.com
#   OIDC_OKTA_CLIENT_ID=
#   OIDC_OKTA_CLIENT_SECRET=
#   OIDC_OKTA_LABEL=Okta
OIDC_PROVIDERS=
# Where this API is reachable from the browser; the OIDC redirect_uri is built
# from it and must match what the provider has registered exactly.
PUBLIC_URL=http://localhost:4000
# Shorthand for Google — equivalent to an OIDC_ provider block.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SSO (SAML 2.0) ---
# For IdPs that speak SAML rather than OIDC. Each provider gets its own ACS URL
# and its own SP entityID, so an assertion for one cannot be replayed at another:
#   ACS      <PUBLIC_URL>/api/auth/sso/saml/<id>/acs
#   metadata <PUBLIC_URL>/api/auth/sso/saml/<id>/metadata   (paste into the IdP)
#   SAML_PROVIDERS=okta
#   SAML_OKTA_ENTRY_POINT=https://your-org.okta.com/app/.../sso/saml
#   SAML_OKTA_IDP_ISSUER=http://www.okta.com/exk...      (the IdP's entityID)
#   SAML_OKTA_CERT=MIIC...          (signing cert body; comma-separate for rollover)
#   SAML_OKTA_LABEL=Okta
# Assertions must always be signed. Set this to also require the response
# envelope to be signed (most IdPs sign only the assertion):
#   SAML_OKTA_WANT_RESPONSE_SIGNED=true
# SAML has no "email_verified". Set this ONLY if the IdP is authoritative for its
# users' email addresses — it allows an assertion to attach to an account that
# already exists here, which is the takeover-capable case. Off by default.
#   SAML_OKTA_TRUST_EMAIL=true
SAML_PROVIDERS=

# Set true ONLY when behind a trusted reverse proxy: it makes the audit log
# believe x-forwarded-for, which an untrusted client could otherwise forge.
TRUST_PROXY=false

# --- Data residency (enterprise) ---
# The region THIS deployment stores data in. Leave blank to disable residency:
# nothing is pinned and every workspace is served as before. Once set, every
# workspace created here is pinned to it permanently, and any workspace pinned
# elsewhere is refused (421) with a pointer to the right deployment.
REGION=
# The fleet, so a refusal can say where to go. Per-region label + URL follow the
# same shape as the OIDC provider blocks.
#   REGIONS=eu,us
#   REGION_EU_LABEL=EU (Frankfurt)
#   REGION_EU_URL=https://eu.yumi.example
#   REGION_US_LABEL=US (Virginia)
#   REGION_US_URL=https://us.yumi.example
REGIONS=
# Features that send workspace contents to a third party are refused in a pinned
# workspace, because pinning storage does not pin processing. List the ones the
# organisation accepts leaving the region (or "all"): ai,github,figma,slack
RESIDENCY_ALLOW_EGRESS=
# Declares the region the model endpoint itself runs in. When it matches a
# workspace's pin, the AI assistant needs no egress exception.
AI_REGION=

# Web (Vite) — see apps/web/.env
VITE_API_URL=http://localhost:4000

# TURN relay for WebRTC fallback (optional; STUN-only without it). Comma-separate
# multiple URLs. Needed for calls to connect behind symmetric NAT / strict firewalls.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Call transport: "mesh" (P2P, ≤4 peers, default) or "sfu" (mediasoup, 5–50).
CALL_MODE=mesh
# mediasoup SFU (only used when CALL_MODE=sfu). announcedIp = the IP the server
# puts in ICE candidates: 127.0.0.1 for same-machine dev, the host LAN/public IP
# for real multi-device calls. Ensure the RTC UDP/TCP port range is reachable.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
